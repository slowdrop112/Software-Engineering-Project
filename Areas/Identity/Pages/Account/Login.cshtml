        <div>
        @foreach (var provider in Model.ExternalLogins!)
        {
        <button type="submit" class="btn btn-secondary w-100 mb-2" name="provider" value="@provider.Name" title="Autentificare cu @provider.DisplayName">@provider.DisplayName</button>
        }
        </div>
        </form>
        }
        }
        </section> *@
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}